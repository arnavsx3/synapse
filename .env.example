# Fresh Postgres database used by the context/chat schema.
DATABASE_URL=

# Redis is supplied by Docker Compose locally. Use redis://localhost:6379 outside Compose.
REDIS_URL=redis://localhost:6379
EMBEDDING_WORKER_CONCURRENCY=2

# Hugging Face Inference Providers uses an OpenAI-compatible chat endpoint.
# Create a token with Inference Providers permission and place it here.
LLM_API_URL=https://router.huggingface.co/v1/chat/completions
LLM_API_KEY=
LLM_MODEL=TinyLlama/TinyLlama-1.1B-Chat-v1.0

# Hugging Face feature-extraction endpoint used by the RAG pipeline.
# The URL is derived from EMBEDDING_MODEL when left blank.
EMBEDDING_API_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSIONS=384
