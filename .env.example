# Fresh Postgres database used by the context/chat schema.
DATABASE_URL=

# Redis is supplied by Docker Compose locally. Use redis://localhost:6379 outside Compose.
REDIS_URL=redis://localhost:6379
EMBEDDING_WORKER_CONCURRENCY=2

# OpenRouter provides the OpenAI-compatible chat and embeddings APIs.
# Create one API key at https://openrouter.ai/keys.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=

# Free chat router; it selects an available free model.
LLM_API_URL=https://openrouter.ai/api/v1/chat/completions
LLM_API_KEY=
LLM_MODEL=openrouter/free

# Free NVIDIA text embedding route used by the RAG pipeline.
# This model returns 2,048-dimensional vectors.
EMBEDDING_API_URL=https://openrouter.ai/api/v1/embeddings
EMBEDDING_API_KEY=
EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b:free
EMBEDDING_DIMENSIONS=2048

# RAG tuning. Chunk offsets are stored against the original context text.
RAG_CHUNK_SIZE=1200
RAG_CHUNK_OVERLAP=200
RAG_RETRIEVAL_LIMIT=8
RAG_MAX_CHUNKS_PER_CONTEXT=2
RAG_MINIMUM_SIMILARITY=0.2
RAG_MAX_QUERY_LENGTH=2000
